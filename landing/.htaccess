# hollr.to — Apache routing rules for SiteGround
#
# Routing strategy:
#   /                     → index.html  (landing page)
#   /auth/verify          → auth/verify.html
#   /auth/verify.html     → auth/verify.html (direct access)
#   /:handle              → handle/index.html (the canvas for that handle)
#
# API calls go to api.hollr.to (separate Fly.io backend via CNAME).
# Static assets (css, js, images) are served normally.

Options -Indexes
RewriteEngine On

# ── Serve auth pages directly ─────────────────────────────────────────────────
RewriteRule ^auth/verify/?$  auth/verify.html [L]

# ── Serve decrypt viewer ──────────────────────────────────────────────────────
RewriteRule ^decrypt/?$  decrypt/index.html [L]

# ── Serve static assets as-is ────────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Route handles to the canvas ───────────────────────────────────────────────
# Everything that doesn't match a file or directory (and isn't 'auth')
# is treated as a :handle and served the canvas page.
# ── Owner alias redirects ──────────────────────────────────────────────────────
# These handles are reserved and redirect permanently to the owner's canvas.
# Also blocked in server.js RESERVED set so they cannot be registered by anyone.
RewriteRule ^paul/?$   https://hollr.to/paulfxyz [R=301,L]
RewriteRule ^p/?$      https://hollr.to/paulfxyz [R=301,L]
RewriteRule ^polo/?$   https://hollr.to/paulfxyz [R=301,L]
RewriteRule ^pablo/?$  https://hollr.to/paulfxyz [R=301,L]
RewriteRule ^paulo/?$  https://hollr.to/paulfxyz [R=301,L]
RewriteRule ^pf/?$     https://hollr.to/paulfxyz [R=301,L]

RewriteCond %{REQUEST_URI} !^/auth/
RewriteCond %{REQUEST_URI} !^/decrypt
RewriteRule ^([a-zA-Z0-9_-]+)/?$  handle/index.html [L]

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Compression ───────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript
</IfModule>

# ── Cache static assets ───────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType text/css  "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
